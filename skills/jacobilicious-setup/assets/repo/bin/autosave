#!/usr/bin/env bash
# Hourly safety net: commit everything, pull, push to main. Never force, never rewrite history.
# The operating system's scheduler runs it every hour (see the jacobilicious-setup skill). Manual run: bin/autosave
set -u
REPO="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO" || exit 1
NAME="$(basename "$REPO")"
LOG="$HOME/.claude/jacobilicious/logs/$NAME-autosave.log"
mkdir -p "$(dirname "$LOG")"
log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"; }

# The scheduler must run this with a PATH that finds git.
command -v git >/dev/null 2>&1 || { log "failed: git not found in PATH"; exit 1; }

# No GitHub copy yet: nothing to sync.
git remote get-url origin >/dev/null 2>&1 || { log "skip: no origin remote"; exit 0; }

# A merge or rebase in progress needs a human.
if [ -d .git/rebase-merge ] || [ -d .git/rebase-apply ] || [ -f .git/MERGE_HEAD ]; then
  log "skip: merge or rebase in progress. Open the repo and say: save"; exit 0
fi

# Backup repo: keep a copy of the global CLAUDE.md.
if [ -d .agents/global-skills ] && [ -f "$HOME/.claude/CLAUDE.md" ]; then cp "$HOME/.claude/CLAUDE.md" .agents/global-claude.md; fi
git add -A
if ! git diff --cached --quiet; then
  git commit -q -m "auto: $(date '+%Y-%m-%d %H:%M') @ $(hostname)" || { log "commit failed. Open the repo and say: save"; exit 1; }
  log "committed"
fi

if ! git pull --rebase -q origin main 2>>"$LOG"; then
  git rebase --abort 2>/dev/null
  log "pull --rebase failed (conflict?), local commits kept. Open the repo and say: save"
  exit 1
fi

if [ -n "$(git log origin/main..HEAD --oneline 2>/dev/null)" ]; then
  git push -q origin main 2>>"$LOG" && log "pushed" || { log "push failed. Internet? GitHub login?"; exit 1; }
fi
exit 0
