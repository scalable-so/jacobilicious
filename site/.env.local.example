# Copy to .env.local for local work. On Vercel, set these in the project settings.

# Required. Signs the personal links and the admin session. 32 characters or more: openssl rand -hex 32
GATE_SECRET=

# Opens /admin. Empty = admin is off.
ADMIN_PIN=

# auto = a rating of 8 or more opens access at once. manual = Jacob approves everyone.
ACCESS_MODE=auto

# Vercel sets this when a Blob store is linked. Without it, records go to .data/ (local only).
BLOB_READ_WRITE_TOKEN=

# Optional. Fixes the address used in links and in the QR code.
SITE_URL=

# Optional. Default: the scalable.so legal pages.
NEXT_PUBLIC_IMPRINT_URL=
NEXT_PUBLIC_PRIVACY_URL=
