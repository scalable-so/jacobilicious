# Copy to .env.local for local work. On Vercel, set these in the project settings.

# Required. Signs the personal links and the admin session. 32 characters or more: openssl rand -hex 32
GATE_SECRET=

# The code on the talk slide. The QR link carries it. Empty = no code needed.
EVENT_CODE=

# Opens /admin. Empty = admin is off.
ADMIN_PIN=

# auto = a rating of 8 or more gets the link by mail at once. manual = Jacob approves everyone.
ACCESS_MODE=auto

# Mail through Resend. Without these two, production puts everyone on the list and
# Jacob copies the personal link in /admin. Preview and local show the mail on screen.
RESEND_API_KEY=
MAIL_FROM="Jacob <jacob@your-domain.com>"

# Jacob gets a note for every new request. Needs the mail settings above.
OWNER_EMAIL=

# Vercel sets this when a Blob store is linked. Without it, records go to .data/ (local only).
BLOB_READ_WRITE_TOKEN=

# Optional. Fixes the address used in links and in the QR code.
SITE_URL=

# Optional. Default: the scalable.so legal pages.
NEXT_PUBLIC_IMPRINT_URL=
NEXT_PUBLIC_PRIVACY_URL=
